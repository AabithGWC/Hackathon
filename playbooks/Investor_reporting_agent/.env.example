# ==============================================================================
# INVESTOR / BOARD REPORTING AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy to .env and fill in the Groq key. Everything else has a working default.
# NEVER put a real key in this file - it is committed. .env is gitignored.

# ---- LLM provider ------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

DEFAULT_LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Rate limits for the model above. The engine reads these and nothing else - it
# has no per-model table, so changing model is a change to these three lines.
#
# LLM_TPM_LIMIT       the model's tokens-per-minute ceiling. Groq admits a
#                     request against prompt + max_tokens, so the engine sizes
#                     the completion budget from what is left under this, and
#                     splits the drafting run into paced batches if the sections
#                     do not fit in one request.
# LLM_MIN_COMPLETION  completion room every request must leave. Raise it to ~3000
#                     for a reasoning model (gpt-oss, qwen3, deepseek-r1): those
#                     spend tokens thinking before emitting anything, and a
#                     request left with too little room returns an EMPTY
#                     completion that surfaces as json_validate_failed.
# LLM_MAX_TOKENS      hard override for the completion budget. Normally unset.
LLM_TPM_LIMIT=12000
LLM_MIN_COMPLETION=1600
# LLM_MAX_TOKENS=3000

# ---- Drafting ----------------------------------------------------------------
# Tone preset id from input_config.yaml:
#   board_formal | investor_narrative | analyst_detailed | concise_summary
COMMENTARY_TONE=board_formal

# Which deck to draft: board | investor
DECK_AUDIENCE=board

# ---- Agent operational parameters --------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PLAYBOOK_NAME=investor_board_commentary_drafting
INPUT_CONFIG_PATH=input_config.yaml

OUTPUT_JSON_PATH=generated_investor_report.json
OUTPUT_MARKDOWN_PATH=generated_commentary.md
OUTPUT_HTML_PATH=reporting_assistant.html
OUTPUT_PDF_PATH=generated_commentary.pdf
