# Provider choice: "ollama" (local or cloud API), "groq" (cloud API), or "auto" (uses Ollama if active, else Groq)
LLM_PROVIDER=ollama

# Ollama Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=your_ollama_api_key_here

# Groq Settings (Single key OR comma-separated multiple keys for automatic rotation & failover)
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_MODEL=llama-3.1-8b-instant
